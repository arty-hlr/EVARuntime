[Unit]
Description=EVARuntime Node Agent (GPU inference worker)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=llmservice
Group=llmservice
WorkingDirectory=/opt/llm-gateway/node_agent
EnvironmentFile=/etc/llm-gateway-agent/env
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0027

ExecStartPre=/opt/llm-gateway/venv-agent/bin/python /opt/llm-gateway/node_agent/preflight.py --env /etc/llm-gateway-agent/env
# `python -m uvicorn` et pas le script console `bin/uvicorn` : défense en
# profondeur, CONSERVÉE après COR-016. update-agent.sh ne déplace plus jamais un
# venv (construction à l'emplacement définitif + bascule par symlink), donc
# `bin/uvicorn` fonctionnerait désormais ; mais `bin/python` est un lien vers
# l'interpréteur système, insensible à tout déplacement, et cette forme a été
# validée en production. Le shebang absolu d'un script console reste le point
# de rupture historique (203/EXEC Permission denied) : ne pas y revenir.
ExecStart=/opt/llm-gateway/venv-agent/bin/python -m uvicorn main:app \
    --host ${AGENT_HOST} \
    --port ${AGENT_PORT} \
    --workers 1 \
    --loop uvloop \
    --ssl-keyfile ${AGENT_TLS_KEY} \
    --ssl-certfile ${AGENT_TLS_CERT}

Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llm-gateway-agent

# Durcissement compatible avec CUDA/NVIDIA : le service peut lire les modèles
# et périphériques GPU, mais ne peut écrire que ses logs et son /tmp privé.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/log/llm-gateway-agent
PrivateTmp=yes
PrivateDevices=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LimitNOFILE=1048576

# ── Limites mémoire — c'est ICI que les modèles vivent en mode cluster ─────────
# Le node-agent lance les llama-server en sous-processus : ils sont dans CE
# cgroup, pas dans celui de l'orchestrateur. La contrainte mémoire pertinente en
# mode cluster est donc celle de cette unité.
# Même raisonnement que gateway/deploy/llm-gateway.service :
#   • modèle entièrement offloadé (-ngl 999 sans cpu_moe) → page cache mmap
#     transitoire ≈ taille du GGUF, résident ≈ 0, KV cache en VRAM ;
#   • modèle `cpu_moe: true` → les experts FFN restent lus depuis le mmap à
#     chaque token et doivent rester RÉSIDENTS en RAM hôte du nœud.
# Une limite inférieure à ce working set ne garantit pas un OOM-kill (pages mmap
# propres = réclamables) mais garantit le thrashing NVMe et l'effondrement du
# TTFT. Pourcentages plutôt que valeurs absolues : le dimensionnement mémoire est
# une propriété du nœud, pas de l'artefact versionné. Table
# « modèle → RAM hôte requise » et procédure : docs/deployment.md §15.
# Le nœud doit avoir assez de RAM pour le plus gros modèle qu'il est autorisé à
# charger ; sinon retirer ce modèle de models.yaml côté orchestrateur.
MemoryHigh=80%
MemoryMax=90%
# Ne jamais swapper un llama-server : refault NVMe d'une page propre < swap-in
# d'une page anonyme, et le swap dégrade durablement le TTFT.
MemorySwapMax=0
# Un llama-server tué par le noyau laisserait de la VRAM orpheline et un slot
# compté « chargé » côté agent : arrêter l'unité et laisser Restart=on-failure
# repartir propre.
OOMPolicy=stop
# ~64 tâches par llama-server x MAX_LOADED_MODELS=5, plus les threads de l'agent.
TasksMax=4096

[Install]
WantedBy=multi-user.target
