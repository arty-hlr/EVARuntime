[Unit]
Description=EVARuntime Multi-node Orchestrator (FastAPI)
Documentation=https://github.com/Tutanka01/EVARuntime
After=network-online.target
Wants=network-online.target

# Profil dédié au mode cluster : cet hôte orchestre les node-agents et ne
# lance aucun llama-server local. Il n'a donc besoin ni du GPU ni de /models.

[Service]
Type=simple
User=llmservice
Group=llmservice
WorkingDirectory=/opt/llm-gateway
EnvironmentFile=/etc/llm-gateway/env

ExecStart=/opt/llm-gateway/venv/bin/uvicorn \
    main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --loop uvloop \
    --log-level info \
    --access-log \
    --no-use-colors

LimitNOFILE=65536
LimitNPROC=1024
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/llm-gateway /var/log/llm-gateway
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @reboot @swap @debug
DevicePolicy=closed

# ── Limites mémoire — topologie cluster ───────────────────────────────────────
# Contrairement à llm-gateway.service, AUCUN llama-server ne tourne dans ce
# cgroup : cet hôte n'orchestre que des node-agents (pas de GPU, pas de /models,
# PrivateDevices=true). Les limites peuvent donc rester absolues et basses, et
# elles sont indépendantes du contenu de models.yaml : la contrainte mémoire des
# modèles s'applique sur les NŒUDS, dans node_agent/deploy/llm-gateway-agent.service.
# Ce qui consomme ici : la gateway (~0.3 Go), les connexions httpx vers les
# nœuds et les buffers de relais SSE (quelques Mo par stream actif) — 8 Go
# laissent une marge très large.
# Ne PAS recopier une table de dimensionnement modèle ici (cf. docs/deployment.md §15).
MemoryHigh=4G
MemoryMax=8G
TasksMax=1024

Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llm-gateway
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
